# Builds the latest commit. Use: makepkg -si

pkgname=plasma-theme-studio-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Edit every part of a KDE Plasma theme in one place"
arch=('any')
url="https://github.com/Kryckan/plasma-theme-studio"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'python-jinja' 'plasma-workspace' 'kconfig' 'hicolor-icon-theme')
makedepends=('git' 'qt6-tools')
provides=('plasma-theme-studio')
conflicts=('plasma-theme-studio')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local version
  version=$(sed -n 's/^__version__ = "\(.*\)"$/\1/p' src/plasma_theme_studio/__init__.py)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  for ts in src/plasma_theme_studio/i18n/*.ts; do
    /usr/lib/qt6/bin/lrelease -silent "$ts" -qm "${ts%.ts}.qm"
  done
}

package() {
  cd "$pkgname"
  local id=io.github.kryckan.PlasmaThemeStudio
  local app="$pkgdir/usr/share/plasma-theme-studio"

  install -d "$app"
  cp -r src/plasma_theme_studio "$app/"
  rm -f "$app"/plasma_theme_studio/i18n/*.ts
  find "$app" -name '__pycache__' -type d -prune -exec rm -r {} +
  python -m compileall -q -s "$pkgdir" -p / "$app"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/plasma-theme-studio" <<'LAUNCHER'
#!/bin/sh
PYTHONPATH="/usr/share/plasma-theme-studio${PYTHONPATH:+:$PYTHONPATH}" exec /usr/bin/python3 -m plasma_theme_studio "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/plasma-theme-studio"

  install -Dm644 "data/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "data/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  install -d "$pkgdir/usr/share/icons"
  cp -r data/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
