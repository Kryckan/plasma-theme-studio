pkgbase = plasma-theme-studio-git
	pkgdesc = Edit every part of a KDE Plasma theme in one place
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/Kryckan/plasma-theme-studio
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = qt6-tools
	depends = python
	depends = pyside6
	depends = python-jinja
	depends = qt6-svg
	depends = qt6-declarative
	depends = kvantum
	depends = kconfig
	depends = plasma-workspace
	depends = hicolor-icon-theme
	optdepends = qt6-tools: qdbus6, to reload KWin and reach Plasma (busctl from systemd is used when it is missing)
	optdepends = rofi: the Rofi target (checks the generated theme before it is applied)
	optdepends = inkscape: Open in Inkscape, for your own panel and popup artwork
	optdepends = python-pywal16: import colors made by pywal (AUR)
	optdepends = matugen: import colors made by matugen
	optdepends = pipewire: the Play button on the System Sounds page (pw-play)
	optdepends = libcanberra: the Play button on the System Sounds page (canberra-gtk-play)
	provides = plasma-theme-studio
	conflicts = plasma-theme-studio
	source = plasma-theme-studio-git::git+https://github.com/Kryckan/plasma-theme-studio.git
	sha256sums = SKIP

pkgname = plasma-theme-studio-git
